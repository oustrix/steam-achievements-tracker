<div class="row">
    <span class="num when">@Run.WhenText</span>
    @* Only a genuine failure is coloured. A cancelled run is the expected
       outcome of pausing, and marking it red would report every pause as
       something having gone wrong. *@
    <span class="what @(Run.Outcome == SyncRunOutcome.Failed ? "failed" : "")">@Run.WhatText</span>
    <span class="num dur">@Run.DurationText</span>
</div>

@code {
    [Parameter, EditorRequired] public SyncRunView Run { get; set; } = default!;
}
