<Project Sdk="Microsoft.NET.Sdk">

  <!--
    net10.0, not net10.0-windows: this tool exists to run on macOS (where
    development happens) as well as Windows, against the real Steam Web API.
    Referencing only Core keeps it free of any Windows-only API.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>SteamAchievements.Cli</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\SteamAchievements.Core\SteamAchievements.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!--
      LoggerFactory and ILoggingBuilder (SetMinimumLevel, AddProvider) for a
      tool whose whole job is to say what the sync engine did. Core brings
      only Microsoft.Extensions.Logging.Abstractions transitively, which has
      the ILogger<T> interfaces but not the concrete factory. Not
      Microsoft.Extensions.Logging.Console: its AddSimpleConsole formats but
      does not scrub, which would print a real Steam Web API key to stdout on
      every request. Diagnostics.ConsoleLogProvider is Core's own console
      sink, sharing the file sink's Redaction.Scrub step by construction.
    -->
    <PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.10" />
  </ItemGroup>

</Project>
