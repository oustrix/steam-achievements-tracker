@page "/settings"
@using SteamAchievements.Core.Sync
@using Microsoft.Data.Sqlite
@implements IDisposable
@inject IUserPreferences Preferences
@inject ILibraryQuery Library
@inject IClock Clock
@inject IAccountAdmin Accounts
@inject IOnboarding Onboarding
@inject ISyncPresenter SyncStatus
@inject ISyncController Sync
@inject LibraryChangeSignal LibraryChanged
@inject IExternalLinks Links

<PageTitle>Settings</PageTitle>

<div class="page">
    <h1>Settings</h1>

    @if (_writeFailed)
    {
        <Notice Severity="NoticeSeverity.Danger" Title="The local database could not be changed">
            <Body>
                Nothing on disk was rewritten as asked. Try again — and if it keeps failing,
                close the application and reopen it, which releases every connection to the file.
            </Body>
        </Notice>
    }

    <div class="account">
        @* Not CoverImage: that component is sized by its parent's .cover rule
           and carries a game-cover placeholder. The .avatar rule already in
           this stylesheet is what the mockup wants here. *@
        @if (_row.AvatarUrl is null)
        {
            <div class="avatar"></div>
        }
        else
        {
            <img class="avatar" src="@_row.AvatarUrl" alt="" />
        }
        <div class="who">
            <span class="name">@_row.Name</span>
            <span class="num id">@_row.Detail</span>
        </div>
        <span class="spacer"></span>
        @if (_gate.Allowed && _pending != Pending.Switch)
        {
            <button class="secondary" type="button" @onclick="() => _pending = Pending.Switch">
                Change account
            </button>
        }
    </div>

    @if (!_gate.Allowed)
    {
        <div class="blocked">@_gate.BlockedReason</div>
    }

    @if (_row.SwitchPrompt is not null && _pending != Pending.Switch)
    {
        @* The offer is still worth stating while a sync runs — the account
           really has changed — but its action is not offered, because taking it
           would empty the library under a live writer. *@
        <Notice Severity="NoticeSeverity.Info" Title="@_row.SwitchPrompt"
                ActionLabel="@SwitchAction" OnAction="() => _pending = Pending.Switch">
            <Body>
                Cached data belongs to the stored account. Blending two libraries would make
                the ranking meaningless, so switching empties the library first.
            </Body>
        </Notice>
    }

    @if (_pending == Pending.Switch)
    {
        <div class="confirm">
            <span class="warn">
                Switching empties the library — @Formatting.Number(_summary.AchievementCount)
                cached achievements — and keeps the stored key. The next sync starts from nothing.
            </span>

            <SteamIdField ActionLabel="Switch to this account" Disabled="@_busy" OnAccepted="Switch" />

            <div class="actions">
                @* Disabled while the switch runs. Hiding the panel while
                   SwitchToAsync is still in flight would give every visual signal of
                   cancellation and then empty the library anyway — and the switch is
                   only cancellable up to the profile lookup, so a Cancel that
                   promised to stop it would be lying about the rest. *@
                <button class="secondary" type="button" disabled="@_busy"
                        @onclick="() => _pending = Pending.None">Cancel</button>

                @if (_row.SwitchTarget is not null)
                {
                    <button class="danger" type="button" disabled="@_busy"
                            @onclick="() => Switch(_row.SwitchTarget.Value)">
                        Yes, switch to @_row.ActiveAccountName
                    </button>
                }
            </div>
        </div>
    }

    <div class="block">
        <div class="label">Steam Web API key</div>
        @if (_replacingKey)
        {
            <ApiKeyForm SubmitLabel="Replace key" OnAccepted="KeyReplaced" />

            @* The form stays mounted after an accepted key so its own "Key
               stored" notice is on screen to read; this is how it is dismissed. *@
            @if (_keyReplaced)
            {
                <button class="secondary done" type="button" @onclick="DoneReplacing">Done</button>
            }
        }
        else
        {
            <div class="key-row">
                <div class="num key">@KeyState</div>
                <button class="secondary" type="button" @onclick="() => _replacingKey = true">Replace</button>
            </div>
        }
        <div class="hint">Encrypted with Windows DPAPI for this user account. Never stored in plaintext.</div>
    </div>

    <div class="block">
        <div class="label">Appearance</div>
        <AccentPicker Selected="@Accent" OnSelect="Choose" />
        <div class="hint">Changes the accent used for effort figures, progress and selection.</div>
    </div>

    <div class="block">
        <div class="label">Cache</div>
        <CacheRow Name="Achievement schema" Note="Rarely changes after release"
                  Value="@($"{SyncOptions.Default.SchemaTtl.TotalDays:0} days")" />
        <CacheRow Name="Global rarity percentages" Note="Drifts slowly as more people play"
                  Value="@($"{SyncOptions.Default.GlobalTtl.TotalDays:0} days")" />
        <div class="hint">These are the sync engine's own decisions and are shown, not edited.</div>
    </div>

    <div class="block">
        <div class="label">Local data</div>
        @* Two buttons rather than one. IExternalLinks.OpenDataFolder had no
           caller anywhere in the application — it was written for a button
           nobody built — so adding "Open log" beside a button that does not
           exist would have left that gap in place. *@
        <div class="files">
            <button class="secondary" type="button" @onclick="() => Links.OpenDataFolder()">
                Open data folder
            </button>
            <button class="secondary" type="button" @onclick="() => Links.OpenLogFile()">
                Open log
            </button>
        </div>
        <div class="hint">
            The log records what the application did, with the API key removed. Attach it
            when reporting a problem.
        </div>
        @if (_pending == Pending.Reset)
        {
            <Notice Severity="NoticeSeverity.Danger" Title="Reset database">
                <Body>
                    This cannot be undone. @Formatting.Number(_summary.AchievementCount) cached
                    achievements, every snapshot and the stored key will be deleted.
                </Body>
            </Notice>
            <div class="confirm">
                <div class="actions">
                    <button class="secondary" type="button" @onclick="() => _pending = Pending.None">Cancel</button>
                    <button class="danger" type="button" @onclick="Reset">Yes, reset</button>
                </div>
            </div>
        }
        else
        {
            <Notice Severity="NoticeSeverity.Danger" Title="Reset database"
                    ActionLabel="@ResetAction" OnAction="() => _pending = Pending.Reset">
                <Body>
                    Deletes @Formatting.Number(_summary.AchievementCount) cached achievements and all
                    snapshots. The next sync starts from nothing.
                </Body>
            </Notice>

            @if (!_gate.Allowed)
            {
                <div class="blocked">@_gate.BlockedReason</div>
            }
        }
    </div>
</div>

@code {
    /// <summary>
    /// Which destructive action is one click from happening. Two-step in place
    /// rather than a modal: a dialog owns a focus trap, Escape and scroll
    /// locking, none of which can be verified anywhere but Windows.
    /// </summary>
    private enum Pending { None, Switch, Reset }

    private readonly CancellationTokenSource _cancellation = new();

    private LibrarySummary _summary = new(0, 0, "", "");
    private AccountRow _row = AccountRowView.For(null, null);
    private DestructiveActionGate _gate = DestructiveActions.For(SyncStatusView.Idle);
    private Pending _pending = Pending.None;
    private bool _replacingKey;
    private bool _keyReplaced;
    private bool _writeFailed;
    private bool _busy;

    private string Accent => Preferences.Accent ?? AccentPalette.Default;

    private string KeyState => Onboarding.Step == OnboardingStep.Ready
        ? "Stored, encrypted for this Windows account"
        : "Not stored yet";

    // A null ActionLabel is how Notice renders no button at all. The offer
    // disappears while the gate is closed; the notice itself stays, because what
    // it observes is still true.
    private string? SwitchAction => _gate.Allowed ? "Switch to it" : null;

    private string? ResetAction => _gate.Allowed ? "Reset" : null;

    protected override void OnInitialized()
    {
        Read();
        _gate = DestructiveActions.For(SyncStatus.Status);

        Accounts.Changed += HandleAccountsChanged;
        LibraryChanged.Changed += HandleLibraryChanged;

        // This screen is the only one that can destroy the library, and doing so
        // while a sync writes blends two accounts silently — so it has to know
        // the phase, not only the summary.
        SyncStatus.Changed += HandleSyncChanged;
    }

    private void Read()
    {
        _summary = Library.GetSummary(Clock.Now);
        _row = AccountRowView.For(Accounts.Current, Accounts.Mismatch);
    }

    private void HandleAccountsChanged() => InvokeAsync(() =>
    {
        _row = AccountRowView.For(Accounts.Current, Accounts.Mismatch);
        StateHasChanged();
    });

    private void HandleSyncChanged() => InvokeAsync(() =>
    {
        _gate = DestructiveActions.For(SyncStatus.Status);

        // A confirmation panel left open when a sync starts is one click from
        // emptying the library under a live writer. Closing it is the only
        // honest answer: the click it was waiting for is no longer safe.
        if (!_gate.Allowed)
        {
            _pending = Pending.None;
        }

        StateHasChanged();
    });

    private void HandleLibraryChanged() => InvokeAsync(() =>
    {
        try
        {
            Read();
        }
        // SQLITE_BUSY and SQLITE_LOCKED only — the race against a sync that has
        // just finished writing. Any other code is a real failure and must not
        // be swallowed forever behind stale data.
        catch (SqliteException e) when (e.SqliteErrorCode is 5 or 6)
        {
            return;
        }

        StateHasChanged();
    });

    private void Choose(string accent) => Preferences.SetAccent(accent);

    private async Task Switch(ulong steamId64)
    {
        _busy = true;
        _writeFailed = false;

        try
        {
            await Accounts.SwitchToAsync(steamId64, _cancellation.Token);
        }
        catch (OperationCanceledException)
        {
            return;
        }
        // Unfiltered, unlike the read path above. This ends in
        // Database.ResetLibrary and a bare VACUUM against a file with three live
        // connections, where SQLITE_BUSY is realistic — but every other code
        // matters just as much, because the user has to know the library was not
        // emptied. An exception leaving a Blazor event handler inside
        // BlazorWebView is a blank window, not a message.
        catch (SqliteException)
        {
            _writeFailed = true;
        }
        finally
        {
            _busy = false;
            _pending = Pending.None;
        }
    }

    // Nothing to navigate to: clearing the stored account makes the step
    // ChooseAccount, and AppShell's guard carries the user to onboarding.
    private void Reset()
    {
        _pending = Pending.None;
        _writeFailed = false;

        try
        {
            Accounts.ResetEverything();
        }
        catch (SqliteException)
        {
            _writeFailed = true;
        }
    }

    /// <summary>
    /// Two things, and neither is obvious.
    ///
    /// The form is left mounted. It sets its "Key stored" notice and then awaits
    /// this callback, so tearing it down here would remove it from the tree
    /// before its own render landed and the replacement would confirm nothing.
    /// "Done" is how the user puts the row back.
    ///
    /// The sync is started for the same reason onboarding starts it: it
    /// re-validates the key at once. It also clears the state that made this
    /// screen necessary — SyncCoordinator publishes Problem = InvalidKey and
    /// only a successful Start overwrites the status wholesale, while
    /// SyncControls disables the sync button for that very problem. Without this
    /// call a replaced key leaves the application unable to sync until it is
    /// restarted.
    /// </summary>
    private void KeyReplaced()
    {
        _keyReplaced = true;
        Sync.Start(force: false);
    }

    private void DoneReplacing()
    {
        _keyReplaced = false;
        _replacingKey = false;
    }

    public void Dispose()
    {
        Accounts.Changed -= HandleAccountsChanged;
        LibraryChanged.Changed -= HandleLibraryChanged;
        SyncStatus.Changed -= HandleSyncChanged;
        _cancellation.Cancel();
        _cancellation.Dispose();
    }
}
